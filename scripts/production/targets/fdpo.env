# FDPO environment (Microsoft-managed tenant fdpo.onmicrosoft.com) — the only
# subscription type that can run Anthropic Claude models. Keyless: Foundry,
# Cosmos and Speech all have local auth disabled; the app uses its managed identity.
export AZURE_CONFIG_DIR="${AZURE_CONFIG_DIR_FDPO:-$HOME/.azure-fdpo}"
EXPECTED_SUBSCRIPTION_ID="07457d67-4b3c-4349-99f7-40b70eafc98b"
RG="rg-aadb-prod"
LOC="eastus2"

VNET="vnet-aadb"
ACA_SUBNET="snet-aca-infra"
PE_SUBNET="snet-private-endpoints"
VNET_CIDR="10.60.0.0/22"
ACA_CIDR="10.60.0.0/23"
PE_CIDR="10.60.2.0/27"

NEW_ENV="cae-aadb-prod"
NEW_APP="azure-diagram-builder"
MCP_APP="azure-diagram-mcp"
ACR="acraadbfdpo"
IMAGE="azure-diagram-builder"
SERVER_APP_INSIGHTS="appi-aadb-server"
WEB_APP_INSIGHTS="appi-aadb-web"
LOG_WORKSPACE="log-aadb-prod"

COSMOS_ACCOUNT="cosmos-aadb-fdpo"
COSMOS_RG="$RG"
COSMOS_LOC="eastus2"
COSMOS_DATABASE_ID="diagrams-db"
COSMOS_CONTAINER_ID="diagrams"
COSMOS_FEEDBACK_CONTAINER_ID="feedback"

SPEECH_RG="$RG"
SPEECH_ACCOUNT="spch-aadb-fdpo"
# Text-to-speech avatar is only offered in a few regions; westus2 is one.
SPEECH_REGION="westus2"

FOUNDRY_ACCOUNT="aif-aadb-fdpo"
FOUNDRY_RG="$RG"
OPENAI_ENDPOINT="https://aif-aadb-fdpo.cognitiveservices.azure.com/"
OPENAI_AUTH="managed-identity"
# Customer details Anthropic requires on every Claude deployment.
ANTHROPIC_ORG_NAME="Microsoft"
ANTHROPIC_INDUSTRY="technology"
ANTHROPIC_COUNTRY_CODE="CA"

# Model deployments: "deployment|model|version|format|sku|capacity(K TPM)"
# Deployment names are also the VITE_AZURE_OPENAI_DEPLOYMENT_* values in .env.
MODEL_DEPLOYMENTS=(
  "gpt-6-sol|gpt-6-sol|2026-09-22|OpenAI|GlobalStandard|300"
  "gpt-6-luna|gpt-6-luna|2026-09-22|OpenAI|GlobalStandard|300"
  "gpt-6-astra|gpt-6-astra|2026-09-03|OpenAI|GlobalStandard|250"
  "gpt-5.4|gpt-5.4|2026-03-05|OpenAI|GlobalStandard|300"
  "gpt-5.4-mini|gpt-5.4-mini|2026-03-17|OpenAI|GlobalStandard|250"
  "gpt-5.6-sol|gpt-5.6-sol|2026-07-09|OpenAI|GlobalStandard|300"
  "gpt-5.6-terra|gpt-5.6-terra|2026-07-09|OpenAI|GlobalStandard|300"
  "gpt-5.6-luna|gpt-5.6-luna|2026-07-09|OpenAI|GlobalStandard|300"
  "claude-opus-5-5|claude-opus-5-5|2|Anthropic|GlobalStandard|40"
  "claude-sonnet-5-5|claude-sonnet-5-5|2|Anthropic|GlobalStandard|80"
  "MAI-Thinking-1|MAI-Thinking-1|2026-06-01|Microsoft|GlobalStandard|250"
  "DeepSeek-V4-Pro|DeepSeek-V4-Pro|2026-04-23|DeepSeek|GlobalStandard|300"
  "grok-4.6|grok-4.6|1|xAI|GlobalStandard|300"
  "Mistral-Large-3|Mistral-Large-3|1|Mistral AI|GlobalStandard|300"
  "Kimi-K2.6|Kimi-K2.6|2026-04-20|MoonshotAI|GlobalStandard|100"
)
TARGET_ENV_FILE=".env.fdpo"
