{
  "name": "azure-architecture-diagram-builder",
  "version": "1.1.0",
  "description": "Azure architecture diagram builder with official icon library",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "./scripts/dev-all.sh",
    "build": "tsc && node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "dev:avatar": "concurrently --names \"token,vite\" --prefix-colors \"cyan,blue\" \"bash scripts/start-token-server.sh\" \"vite --port 3002 --strictPort\"",
    "demo:record": "node scripts/demo-recording.mjs",
    "pricing:refresh": "node scripts/refresh-pricing-data.mjs",
    "pricing:audit": "node scripts/audit-pricing-coverage.mjs",
    "pricing:audit-semantics": "tsx scripts/audit-pricing-semantics.ts",
    "test:arm": "node scripts/test-arm-extractor.mjs",
    "test:dagre-migration": "tsx scripts/test-dagre-migration.ts",
    "test:layout-preservation": "tsx scripts/test-layout-preservation.ts",
    "test:grouped-layout": "tsx scripts/test-grouped-layout.ts",
    "test:edge-label-layout": "tsx scripts/test-edge-label-layout.ts",
    "test:validation-freshness": "tsx scripts/test-validation-freshness.ts",
    "test:impact": "tsx scripts/test-impact-measurement.ts",
    "test:impact-records": "node scripts/test-impact-records.cjs",
    "test:production-exclusions": "node scripts/test-production-exclusions.mjs",
    "test:service-names": "tsx scripts/test-service-name-normalization.ts",
    "test:pricing-mode": "tsx scripts/test-pricing-mode-calculator.ts",
    "eval:aadb:build": "node scripts/evaluations/build-aadb-seed.mjs",
    "eval:aadb:deterministic": "node scripts/evaluations/run-aadb-deterministic.mjs",
    "eval:aadb:verify": "node scripts/evaluations/test-aadb-baseline.mjs",
    "eval:aadb": "npm run eval:aadb:build && npm run eval:aadb:deterministic && npm run eval:aadb:verify",
    "eval:aadb:v2:contract": "tsx scripts/evaluations/test-aadb-contract-v2.ts",
    "eval:aadb:v2:capture": "tsx scripts/evaluations/capture-aadb-v2.ts",
    "eval:aadb:v2:build": "node scripts/evaluations/build-aadb-seed-v2.mjs",
    "eval:aadb:v2:deterministic": "node scripts/evaluations/run-aadb-deterministic-v2.mjs",
    "eval:aadb:v2:verify": "node scripts/evaluations/test-aadb-v2.mjs",
    "eval:aadb:v2:scorecard": "node scripts/evaluations/build-aadb-model-scorecard-v2.mjs",
    "eval:aadb:v2": "npm run eval:aadb:v2:contract && npm run eval:aadb:v2:build && npm run eval:aadb:v2:deterministic && npm run eval:aadb:v2:scorecard && npm run eval:aadb:v2:verify",
    "eval:aadb:v2:review:status": "node scripts/evaluations/review-aadb-v2-interactive.mjs --status",
    "eval:aadb:v2:review:interactive": "node scripts/evaluations/review-aadb-v2-interactive.mjs",
    "eval:aadb:v2:review": "node scripts/evaluations/finalize-aadb-v2-review.mjs",
    "mcp:build": "cd mcp-server && npm run build",
    "mcp:start": "node mcp-server/dist/index.js"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.17.0",
    "@azure/openai": "^2.0.0",
    "@dagrejs/dagre": "3.1.1",
    "@microsoft/applicationinsights-web": "^3.3.11",
    "elkjs": "^0.11.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.294.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.48.0",
    "pptxgenjs": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reactflow": "^11.10.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/dom-to-image": "^2.6.7",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "playwright": "^1.58.2",
    "tsx": "^4.23.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
