"// Generated by AADB Physical Architecture Studio (Technical Preview).
// AVM-aligned. Deterministic output derived from the physical manifest.
// DO NOT hand-edit: regenerate from the manifest instead.

targetScope = 'resourceGroup'

@description('Primary Azure region for all resources.')
param location string = 'eastus2'

// platform landing zone: connectivity-hub
module vnet_hub_vnet 'br/public:avm/res/network/virtual-network:0.5.1' = {
  name: 'deploy-hub-vnet'
  params: {
    name: 'hub-vnet'
    location: location
    addressPrefixes: [
      '10.20.0.0/16'
    ]
    subnets: [
      {
        name: 'AzureFirewallSubnet'
        addressPrefix: '10.20.0.0/26'
      }
      {
        name: 'GatewaySubnet'
        addressPrefix: '10.20.0.64/27'
      }
      {
        name: 'management'
        addressPrefix: '10.20.1.0/24'
      }
    ]
  }
}

// application landing zone: ai-workload-spoke
module vnet_spoke_ai_vnet 'br/public:avm/res/network/virtual-network:0.5.1' = {
  name: 'deploy-spoke-ai-vnet'
  params: {
    name: 'spoke-ai-vnet'
    location: location
    addressPrefixes: [
      '10.21.0.0/16'
    ]
    subnets: [
      {
        name: 'container-apps'
        addressPrefix: '10.21.0.0/23'
        delegation: 'Microsoft.App/environments'
      }
      {
        name: 'private-endpoints'
        addressPrefix: '10.21.2.0/24'
      }
    ]
  }
}

module pdns_privatelink_openai_azure_com 'br/public:avm/res/network/private-dns-zone:0.7.0' = {
