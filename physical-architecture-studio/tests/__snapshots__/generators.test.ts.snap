          privateIPAddress: '10.21.2.4'
        }
      }
    ]
    privateDnsZoneGroup: {
      privateDnsZoneGroupConfigs: [
        { privateDnsZoneResourceId: pdns_privatelink_openai_azure_com.outputs.resourceId }
      ]
    }
  }
}

