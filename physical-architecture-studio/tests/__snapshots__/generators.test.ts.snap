module pe_pe_aoai 'br/public:avm/res/network/private-endpoint:0.10.1' = {
  name: 'deploy-pe-aoai'
  params: {
    name: 'pe-aoai'
    location: location
    subnetResourceId: '\${vnet_spoke_ai_vnet.outputs.resourceId}/subnets/private-endpoints'
    privateLinkServiceConnections: [
      {
        name: 'pe-aoai-connection'
        properties: {
          // privateLinkServiceId is supplied when the workload service is deployed
          privateLinkServiceId: '<aoai-resource-id>'
          groupIds: [ 'account' ]
        }
      }
    ]
    // Deterministically allocated by the IPAM engine
    ipConfigurations: [
      {
        name: 'pe-aoai-ipconfig'
        properties: {
          groupId: 'account'
