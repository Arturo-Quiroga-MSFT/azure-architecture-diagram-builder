exports[`Terraform emitter > matches snapshot 1`] = `
"# Generated by AADB Physical Architecture Studio (Technical Preview).
# AVM-aligned. Deterministic output derived from the physical manifest.
# DO NOT hand-edit: regenerate from the manifest instead.

terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
  }
}

variable "location" {
  type    = string
  default = "eastus2"
}

variable "resource_group_name" {
  type = string
}

# platform landing zone: connectivity-hub
module "vnet_hub_vnet" {
  source  = "Azure/avm-res-network-virtualnetwork/azurerm"
  version = "0.8.1"

  name                = "hub-vnet"
  location            = var.location
  resource_group_name = var.resource_group_name
  address_space       = ["10.20.0.0/16"]

  subnets = {
    AzureFirewallSubnet = {
      name             = "AzureFirewallSubnet"
      address_prefixes = ["10.20.0.0/26"]
    }
    GatewaySubnet = {
      name             = "GatewaySubnet"
      address_prefixes = ["10.20.0.64/27"]
    }
    management = {
      name             = "management"
      address_prefixes = ["10.20.1.0/24"]
    }
  }
}

# application landing zone: ai-workload-spoke
module "vnet_spoke_ai_vnet" {
  source  = "Azure/avm-res-network-virtualnetwork/azurerm"
  version = "0.8.1"

  name                = "spoke-ai-vnet"
  location            = var.location
  resource_group_name = var.resource_group_name
  address_space       = ["10.21.0.0/16"]

  subnets = {
    container_apps = {
      name             = "container-apps"
      address_prefixes = ["10.21.0.0/23"]
      delegation = [{
        name = "container_apps-delegation"
        service_delegation = {
          name = "Microsoft.App/environments"
        }
      }]
    }
    private_endpoints = {
      name             = "private-endpoints"
      address_prefixes = ["10.21.2.0/24"]
    }
  }
}

module "pdns_privatelink_openai_azure_com" {
  source  = "Azure/avm-res-network-privatednszone/azurerm"
  version = "0.3.3"

  domain_name         = "privatelink.openai.azure.com"
  resource_group_name = var.resource_group_name

  virtual_network_links = {
    spoke_ai_vnet = { vnetlinkname = "spoke-ai-vnet-link", vnetid = module.vnet_spoke_ai_vnet.resource_id }
  }
}

module "pdns_privatelink_search_windows_net" {
  source  = "Azure/avm-res-network-privatednszone/azurerm"
  version = "0.3.3"

  domain_name         = "privatelink.search.windows.net"
  resource_group_name = var.resource_group_name

  virtual_network_links = {
    spoke_ai_vnet = { vnetlinkname = "spoke-ai-vnet-link", vnetid = module.vnet_spoke_ai_vnet.resource_id }
  }
}

module "pdns_privatelink_blob_core_windows_net" {
  source  = "Azure/avm-res-network-privatednszone/azurerm"
  version = "0.3.3"

  domain_name         = "privatelink.blob.core.windows.net"
  resource_group_name = var.resource_group_name

  virtual_network_links = {
    spoke_ai_vnet = { vnetlinkname = "spoke-ai-vnet-link", vnetid = module.vnet_spoke_ai_vnet.resource_id }
  }
}

module "pdns_privatelink_documents_azure_com" {
  source  = "Azure/avm-res-network-privatednszone/azurerm"
  version = "0.3.3"

  domain_name         = "privatelink.documents.azure.com"
  resource_group_name = var.resource_group_name

  virtual_network_links = {
    spoke_ai_vnet = { vnetlinkname = "spoke-ai-vnet-link", vnetid = module.vnet_spoke_ai_vnet.resource_id }
  }
}

module "pdns_privatelink_vaultcore_azure_net" {
  source  = "Azure/avm-res-network-privatednszone/azurerm"
  version = "0.3.3"

  domain_name         = "privatelink.vaultcore.azure.net"
  resource_group_name = var.resource_group_name

  virtual_network_links = {
    spoke_ai_vnet = { vnetlinkname = "spoke-ai-vnet-link", vnetid = module.vnet_spoke_ai_vnet.resource_id }
  }
}

module "pe_pe_aoai" {
  source  = "Azure/avm-res-network-privateendpoint/azurerm"
  version = "0.2.0"

  name                = "pe-aoai"
  location            = var.location
  resource_group_name = var.resource_group_name
  subnet_resource_id  = module.vnet_spoke_ai_vnet.subnets["private_endpoints"].resource_id
  subresource_names   = ["account"]

  # Deterministically allocated by the IPAM engine
  private_ip_address = "10.21.2.4"

  private_dns_zone_group = {
    name                 = "pe-aoai-dns"
    private_dns_zone_ids = [module.pdns_privatelink_openai_azure_com.resource_id]
  }
}

module "pe_pe_search" {
  source  = "Azure/avm-res-network-privateendpoint/azurerm"
  version = "0.2.0"

  name                = "pe-search"
  location            = var.location
  resource_group_name = var.resource_group_name
  subnet_resource_id  = module.vnet_spoke_ai_vnet.subnets["private_endpoints"].resource_id
  subresource_names   = ["searchService"]

  # Deterministically allocated by the IPAM engine
  private_ip_address = "10.21.2.7"

  private_dns_zone_group = {
    name                 = "pe-search-dns"
    private_dns_zone_ids = [module.pdns_privatelink_search_windows_net.resource_id]
  }
}

module "pe_pe_storage" {
  source  = "Azure/avm-res-network-privateendpoint/azurerm"
  version = "0.2.0"

  name                = "pe-storage"
  location            = var.location
  resource_group_name = var.resource_group_name
  subnet_resource_id  = module.vnet_spoke_ai_vnet.subnets["private_endpoints"].resource_id
  subresource_names   = ["blob"]

  # Deterministically allocated by the IPAM engine
  private_ip_address = "10.21.2.8"

  private_dns_zone_group = {
    name                 = "pe-storage-dns"
    private_dns_zone_ids = [module.pdns_privatelink_blob_core_windows_net.resource_id]
  }
}

module "pe_pe_cosmos" {
  source  = "Azure/avm-res-network-privateendpoint/azurerm"
  version = "0.2.0"

  name                = "pe-cosmos"
  location            = var.location
  resource_group_name = var.resource_group_name
  subnet_resource_id  = module.vnet_spoke_ai_vnet.subnets["private_endpoints"].resource_id
  subresource_names   = ["Sql"]

  # Deterministically allocated by the IPAM engine
  private_ip_address = "10.21.2.5"

  private_dns_zone_group = {
    name                 = "pe-cosmos-dns"
    private_dns_zone_ids = [module.pdns_privatelink_documents_azure_com.resource_id]
  }
}

module "pe_pe_keyvault" {
  source  = "Azure/avm-res-network-privateendpoint/azurerm"
  version = "0.2.0"

  name                = "pe-keyvault"
  location            = var.location
  resource_group_name = var.resource_group_name
  subnet_resource_id  = module.vnet_spoke_ai_vnet.subnets["private_endpoints"].resource_id
  subresource_names   = ["vault"]

  # Deterministically allocated by the IPAM engine
  private_ip_address = "10.21.2.6"

  private_dns_zone_group = {
    name                 = "pe-keyvault-dns"
    private_dns_zone_ids = [module.pdns_privatelink_vaultcore_azure_net.resource_id]
  }
}
"
`;
