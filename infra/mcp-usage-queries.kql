// AADB MCP server — usage queries (Log Analytics workspace of the ACA environment).
// Source: one JSON line per HTTP request written by mcp-server/src/usageLog.ts
// (event == "mcp_request"). Records carry tenantId/objectId only — no names,
// emails, tokens or tool arguments. Resolve an objectId to a person in Entra
// (az ad user show --id <objectId>) only when you need to follow up.

// ── Base: parsed MCP request records ───────────────────────────────────────
let McpRequests = ContainerAppConsoleLogs_CL
| where ContainerAppName_s == "azure-diagram-mcp"
| where Log_s startswith "{" and Log_s has "\"mcp_request\""
| extend r = parse_json(Log_s)
| project TimeGenerated, Status = toint(r.status), DurationMs = toint(r.durationMs),
    Auth = tostring(r.auth), AuthError = tostring(r.authError),
    TenantId = tostring(r.tenantId), ObjectId = tostring(r.objectId),
    ClientName = tostring(r.clientName), ClientVersion = tostring(r.clientVersion),
    UserAgent = tostring(r.userAgent), RpcMethods = r.rpcMethods, Tools = r.tools,
    ToolResults = r.toolResults, Revision = tostring(r.revision);
//
// ── 1. Daily summary: successful calls, distinct users, auth failures ─────
McpRequests
| where TimeGenerated > ago(14d)
| summarize Requests = count(),
    Ok = countif(Status between (200 .. 299)),
    AuthRejected = countif(Auth == "rejected"),
    EntraUsers = dcountif(ObjectId, Auth == "entra" and isnotempty(ObjectId)),
    Tenants = dcountif(TenantId, isnotempty(TenantId)),
    StaticTokenCalls = countif(Auth == "static"),
    ToolCalls = countif(array_length(Tools) > 0)
  by Day = bin(TimeGenerated, 1d)
| order by Day desc

// ── 2. Who is using it (per Entra user / tenant) ──────────────────────────
// McpRequests
// | where TimeGenerated > ago(30d) and Auth == "entra"
// | summarize FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated), Requests = count(),
//     ToolCalls = countif(array_length(Tools) > 0), Clients = make_set_if(ClientName, isnotempty(ClientName))
//   by TenantId, ObjectId
// | order by LastSeen desc

// ── 3. Sign-in / auth failures by reason (e.g. a user stuck on OAuth) ─────
// McpRequests
// | where TimeGenerated > ago(7d) and Auth == "rejected"
// | summarize Count = count(), LastSeen = max(TimeGenerated) by AuthError, UserAgent
// | order by Count desc

// ── 4. Tool usage and failure rate ─────────────────────────────────────────
// McpRequests
// | where TimeGenerated > ago(30d)
// | mv-expand T = ToolResults
// | summarize Calls = count(), Failures = countif(tobool(T.ok) == false),
//     P50Ms = percentile(toint(T.durationMs), 50), P95Ms = percentile(toint(T.durationMs), 95),
//     LastError = take_anyif(tostring(T.error), tobool(T.ok) == false)
//   by Tool = tostring(T.tool)
// | order by Calls desc

// ── 5. MCP clients in use (from initialize) ────────────────────────────────
// McpRequests
// | where TimeGenerated > ago(30d) and RpcMethods has "initialize"
// | summarize Sessions = count(), Users = dcount(ObjectId) by ClientName, ClientVersion, Auth
// | order by Sessions desc

// ── 6. Follow one user (paste their Entra objectId) ────────────────────────
// McpRequests
// | where TimeGenerated > ago(7d) and ObjectId == "<objectId>"
// | project TimeGenerated, Status, Auth, ClientName, Tools, ToolResults, DurationMs
// | order by TimeGenerated desc
