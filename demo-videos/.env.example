# Copy to demo-videos/.env (git-ignored) and fill in. Environment variables override these values.

# App to record (default: the public AADB short link).
AADB_APP_URL=https://aka.ms/diagram-builder

# Azure AI Speech for narration (keyless: your Azure CLI identity needs "Cognitive Services Speech User").
SPEECH_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<speech-account>
SPEECH_REGION=westus2

# Optional: a separate Azure CLI profile for narration and Episode 8.
# AZURE_CONFIG_DIR=/path/to/.azure-profile

# Optional: an empty resource group for Episode 8's `az deployment group what-if` (otherwise it shows the build only).
# WHATIF_RESOURCE_GROUP=rg-demo-video-whatif

# Episode 10: the AADB MCP server and a personal client key (never commit the key).
# AADB_MCP_URL=https://<aadb-mcp-host>/mcp
# AADB_MCP_KEY=<your-client-key>
# COPILOT_MODEL=<model, e.g. one your organization enables>

# Optional tool overrides (defaults: found on PATH, or engine/.venv for Python).
# PYTHON=python3
# FFMPEG=ffmpeg
# FFPROBE=ffprobe
# SOFFICE=soffice
# PDFTOPPM=pdftoppm

# Optional: where finished videos go (default: demo-videos/videos).
# OUTPUT_DIR=/path/to/videos
