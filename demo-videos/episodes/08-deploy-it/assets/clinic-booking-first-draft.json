  "architectureName": "Clinic Booking \u00b7 first draft",
  "author": "Azure Architect",
  "version": "1.0",
  "date": "10/22/2026",
  "savedAt": "2026-10-22T16:47:06.003Z"
 },
 "workflow": [
  {
   "step": 1,
   "description": "A patient opens the booking website hosted by App Service.",
   "services": [
    "app-service"
   ]
  },
  {
   "step": 2,
   "description": "The web front end submits appointment details or referral files to the Azure Functions booking API.",
   "services": [
    "app-service",
    "azure-functions"
   ]
  },
  {
   "step": 3,
   "description": "The booking API uses its managed identity and retrieves required secrets from Key Vault.",
   "services": [
    "entra-id",
    "azure-functions",
    "key-vault"
   ]
  },
  {
   "step": 4,
   "description": "The API validates the request and creates or updates the appointment in SQL Database.",
   "services": [
    "azure-functions",
    "sql-database"
   ]
  },
  {
   "step": 5,
   "description": "Referral letters and scans are uploaded to or retrieved from the Storage Account.",
   "services": [
    "azure-functions",
    "storage-account"
   ]
  },
  {
   "step": 6,
   "description": "The API emits request and dependency telemetry to Application Insights, which is retained in Log Analytics.",
   "services": [
    "azure-functions",
    "application-insights",
    "log-analytics"
   ]
  }
 ],
 "architecturePrompt": "Patient appointment booking for a regional clinic network: web front end, booking API, appointments database, referral documents, secrets and monitoring. First draft.",
 "originalPrompt": "Patient appointment booking for a regional clinic network: web front end, booking API, appointments database, referral documents, secrets and monitoring. First draft."
